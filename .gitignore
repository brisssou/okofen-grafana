# Runtime data generated by Prometheus/containers
prometheus/data/
prometheus/wal/
prometheus/chunks_head/
prometheus/queries.active
prometheus/lock

# Local logs / transient runtime files
*.log
*.pid

# Python local environment and caches
.venv/
venv/
__pycache__/
.pytest_cache/

# Optional: ignore local environment files if you don't want them in git
.env
.env.*

# Keep source/config files tracked
!grafana/
!grafana/config/
!grafana/provisioning/
!prometheus/etc/
